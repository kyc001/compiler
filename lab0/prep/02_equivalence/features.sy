const int limit = 12;
int calls = 0;

int bump() {
    calls = calls + 1;
    return 1;
}

int factorial(int n) {
    int result = 1;
    int i = 1;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

int arithmetic(int n) {
    int a = +n;
    int b = -n;
    return (a * 3 + b) / 2 + a % 3;
}

int control(int n) {
    int i = 0;
    int total = 0;
    while (i < n) {
        i = i + 1;
        if (i == 3) {
            continue;
        }
        if (i >= 9) {
            break;
        }
        total = total + i;
    }
    return total;
}

int scope(int n) {
    int x = n;
    {
        const int bias = 7;
        int x = bias;
        n = n + x;
    }
    return n + x;
}

int logic(int n) {
    calls = 0;
    if ((n > 0 && bump() != 0) || bump() != 0) {
        calls = calls + 10;
    }
    if (!(n < 0) && (n >= 0 || bump() != 0)) {
        calls = calls + 100;
    }
    return calls;
}

int main() {
    int n = getint();
    if (n < 0 || n > limit) {
        putint(-1);
        putch(10);
        return 0;
    }
    putint(factorial(n));
    putch(32);
    putint(arithmetic(n));
    putch(32);
    putint(control(n));
    putch(32);
    putint(scope(n));
    putch(32);
    putint(logic(n));
    putch(10);
    return 0;
}

